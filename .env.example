# CardioThoNoa — configuration Supabase (synchronisation cloud + authentification)
#
# Copier ce fichier en `.env.local` puis renseigner les deux valeurs ci-dessous,
# disponibles dans le dashboard Supabase :
#   Project Settings → API → Project URL  et  Project API keys → anon / public
#
# Sans ces variables, l'application ne peut pas démarrer (login obligatoire).
# Aucune donnée patient n'est jamais envoyée au cloud (voir lib/syncEngine.js).

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# ── Script de seed du catalogue de gestes (npm run seed:catalog) ───────────────
# Variables côté Node UNIQUEMENT (sans préfixe VITE_, pour ne jamais les exposer
# dans le bundle client). Utilisées par scripts/seedCatalog.mjs pour pousser
# src/data/procedureTypes.js vers la table partagée `procedure_types`.
#   SUPABASE_URL              : même valeur que VITE_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY : Project Settings → API → service_role (SECRÈTE,
#                               bypasse la RLS — ne jamais committer ni exposer)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete
